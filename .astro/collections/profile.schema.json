{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "anyOf": [
    {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "fullName": {
            "type": "string",
            "minLength": 1
          },
          "role": {
            "type": "object",
            "properties": {
              "fr": {
                "type": "string",
                "minLength": 1
              },
              "en": {
                "default": "",
                "type": "string"
              }
            },
            "required": [
              "fr"
            ]
          },
          "tagline": {
            "type": "object",
            "properties": {
              "fr": {
                "type": "string",
                "minLength": 1
              },
              "en": {
                "default": "",
                "type": "string"
              }
            },
            "required": [
              "fr"
            ]
          },
          "bio": {
            "type": "object",
            "properties": {
              "fr": {
                "type": "string",
                "minLength": 1
              },
              "en": {
                "default": "",
                "type": "string"
              }
            },
            "required": [
              "fr"
            ]
          },
          "location": {
            "type": "object",
