              "fr": {
                "type": "string",
                "minLength": 1
              },
              "en": {
                "default": "",
                "type": "string"
              }
            },
            "required": [
              "fr"
            ]
          },
          "portrait": {
            "type": "string"
          },
          "email": {
            "type": "string",
            "format": "email",
            "pattern": "^(?:[A-Za-z0-9_'+\\-]+\\.)*[A-Za-z0-9_'+\\-]*[A-Za-z0-9_+-]@(?:[A-Za-z0-9][A-Za-z0-9\\-]*\\.)+[A-Za-z]{2,}$"
          },
          "showEmail": {
            "default": false,
            "type": "boolean"
          },
          "githubLogin": {
            "type": "string",
            "minLength": 1
          },
          "socials": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "kind": {
                  "type": "string",
                  "enum": [
                    "github",
                    "linkedin",
                    "x",
                    "bluesky",
                    "website",
                    "other"
                  ]
                },
                "url": {
                  "type": "string",
                  "format": "uri"
                },
                "label": {
                  "type": "string"
                }
              },
              "required": [
                "kind",
                "url"
              ]
            }
          }
        },
        "required": [
          "fullName",
          "role",
          "tagline",
          "bio",
          "githubLogin",
          "socials"
        ]
      }
    },
