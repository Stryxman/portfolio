{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "title": {
      "type": "object",
      "properties": {
        "fr": {
          "type": "string",
          "minLength": 1
        },
        "en": {
          "default": "",
          "type": "string"
        }
      },
      "required": [
        "fr"
      ]
    },
    "summary": {
      "type": "object",
      "properties": {
        "fr": {
          "type": "string",
          "minLength": 1
        },
        "en": {
          "default": "",
          "type": "string"
        }
      },
      "required": [
        "fr"
      ]
    },
    "role": {
      "type": "object",
      "properties": {
        "fr": {
          "type": "string",
          "minLength": 1
        },
        "en": {
          "default": "",
          "type": "string"
        }
      },
      "required": [
        "fr"
      ]
    },
    "provenance": {
      "type": "string",
      "enum": [
        "claude-code",
        "hand-coded",
        "cms",
        "other"
      ]
    },
    "platform": {
      "type": "string"
    },
    "stack": {
      "type": "array",
      "items": {
        "anyOf": [
          {
            "type": "number"
          },
          {
            "type": "string"
          },
          {
            "type": "object",
            "properties": {
              "id": {
                "type": "string"
              },
              "collection": {
                "type": "string"
              }
            },
            "required": [
              "id",
              "collection"
            ]
          },
          {
            "type": "object",
            "properties": {
              "slug": {
                "type": "string"
              },
              "collection": {
                "type": "string"
              }
            },
            "required": [
              "slug",
              "collection"
            ]
          }
        ]
      }
    },
    "tags": {
      "default": [],
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "status": {
      "default": "draft",
      "type": "string",
      "enum": [
        "draft",
        "published",
        "archived"
      ]
    },
    "featured": {
      "default": false,
      "type": "boolean"
    },
    "order": {
      "default": 100,
      "type": "integer",
      "minimum": -9007199254740991,
      "maximum": 9007199254740991
    },
    "start": {
      "type": "string",
      "pattern": "^\\d{4}(-(0[1-9]|1[0-2]))?$"
    },
    "end": {
      "type": "string",
      "pattern": "^\\d{4}(-(0[1-9]|1[0-2]))?$"
    },
    "liveUrl": {
      "type": "string",
      "format": "uri"
    },
    "repo": {
      "type": "string",
      "pattern": "^[\\w.-]+\\/[\\w.-]+$"
    },
    "cover": {
      "type": "string"
    },
    "gallery": {
      "default": [],
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "src": {
            "type": "string"
          },
          "alt": {
            "type": "object",
            "properties": {
              "fr": {
                "type": "string",
                "minLength": 1
              },
              "en": {
                "default": "",
                "type": "string"
              }
            },
            "required": [
              "fr"
            ]
          }
        },
        "required": [
          "src",
          "alt"
        ]
      }
    },
    "preview": {
      "default": {
        "mode": "auto"
      },
      "type": "object",
      "properties": {
        "mode": {
          "default": "auto",
          "type": "string",
          "enum": [
            "auto",
            "iframe",
            "screenshot",
            "none"
          ]
        }
      }
    },
    "$schema": {
      "type": "string"
    }
  },
  "required": [
    "title",
    "summary",
    "provenance"
  ]
}