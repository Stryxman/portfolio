---
import Base from "../layouts/Base.astro";
import type { Locale } from "../i18n/config";
import { t } from "../i18n/ui";
import { alternatesFor } from "../i18n/routes";
import { PROJECT_CATEGORIES } from "../lib/content/schemas";
import { cardOf, getProfile, getProjectEntries } from "../lib/content/queries";
import ProjectCard from "../components/ProjectCard.astro";
interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
const { fullName } = await getProfile();
const cards = (await getProjectEntries()).map((e) => cardOf(e, locale));
// une section par catégorie qui a au moins un projet, dans l'ordre de PROJECT_CATEGORIES
const groups = PROJECT_CATEGORIES.map(
  (c) => [c, cards.filter((card) => card.category === c)] as const,
).filter(([, list]) => list.length > 0);
const title = t(locale, "page.projects.title");
---

<Base
  locale={locale}
  title={`${title} | ${fullName}`}
  description={t(locale, "page.projects.description")}
  alternates={alternatesFor("projects")}
>
  <div class="mx-auto max-w-[1240px] px-6 py-16 md:px-10 md:py-28">
    <h1 class="text-h1">{title}</h1>
    {cards.length === 0 && <p class="mt-12 text-ink-muted">{t(locale, "projects.none")}</p>}
    {groups.map(([category, list]) => (
      <section data-category={category} class="mt-16 first-of-type:mt-12">
        <h2 class="text-h2">{t(locale, `category.${category}`)}</h2>
        <div data-grid class="mt-8 grid gap-x-10 gap-y-16 md:grid-cols-2">
          {list.map((card) => (
            <ProjectCard card={card} locale={locale} />
          ))}
        </div>
      </section>
    ))}
  </div>
</Base>
