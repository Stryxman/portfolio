---
import { Icon } from "astro-icon/components";
import { getImage, Image } from "astro:assets";
import Base from "../layouts/Base.astro";
import type { Locale } from "../i18n/config";
import { fmt, t } from "../i18n/ui";
import { pathFor, projectPath } from "../i18n/routes";
import { localize } from "../lib/content/select";
import {
  cardOf,
  imageOf,
  getProfile,
  getProjectBody,
  getProjectEntries,
  getSkills,
} from "../lib/content/queries";
import { domainOf, neighbours, projectStatus } from "../lib/projects/model";
import { FICHE_SIZES, PREVIEW_WIDTHS } from "../lib/projects/preview";
import ProjectImage from "../components/ProjectImage.astro";
import Seal from "../components/Seal.astro";
import Tag from "../components/Tag.astro";
import Button from "../components/Button.astro";
interface Props {
  locale: Locale;
  slug: string;
}
const { locale, slug } = Astro.props;
const entries = await getProjectEntries();
const entry = entries.find((e) => e.id === slug);
if (!entry) throw new Error(`projet introuvable : ${slug}`); // getStaticPaths ne génère que les projets visibles
const { data } = entry;
const { fullName } = await getProfile();
const card = cardOf(entry, locale);
const skillNames = new Map((await getSkills()).map((s) => [s.id, s.name]));
const stack = data.stack.map((s) => skillNames.get(s.id) ?? s.id);
const role = data.role ? localize(data.role, locale) : undefined;
const status = projectStatus(data.start, data.end);
const body = await getProjectBody(slug, locale);
const { prev, next } = neighbours(
  entries.map((e) => e.id),
  slug,
);
// les liens « projet précédent / suivant » n'ont pas d'image dans la page : on leur donne le srcset de la fiche
// visée, pour que Base la précharge au survol et que la fiche s'ouvre avec son image déjà là
const srcsetOf = async (id: string | undefined) => {
  const image = id && imageOf(entries.find((e) => e.id === id)!);
  return image
    ? (await getImage({ src: image, widths: PREVIEW_WIDTHS })).srcSet.attribute
    : undefined;
};
const [prevSrcset, nextSrcset] = await Promise.all([srcsetOf(prev), srcsetOf(next)]);
const titleOf = (id: string) => localize(entries.find((e) => e.id === id)!.data.title, locale);
const langOf = (lang: Locale) => (lang === locale ? undefined : lang);
const dt = "text-ink-muted";
---

<Base
  locale={locale}
  title={`${card.title.text} | ${fullName}`}
  description={card.summary.text}
  alternates={{ fr: projectPath(slug, "fr"), en: projectPath(slug, "en") }}
>
  <article class="mx-auto grid max-w-[1240px] gap-12 px-6 py-16 md:grid-cols-12 md:gap-10 md:px-10 md:py-28">
    <!-- fermer : revient d'un cran dans l'historique quand la fiche a été ouverte depuis le site, pour que
         l'aperçu redescende dans sa carte ; sinon, le lien mène à la grille des projets -->
    <a
      data-close
      href={pathFor("projects", locale)}
      class="-my-4 inline-flex h-11 items-center gap-2 justify-self-end text-small text-ink-muted transition-colors duration-[var(--dur-hover)] hover:text-ink md:col-span-12"
    >
      {t(locale, "project.close")}
      <Icon name="ph:x" class="size-4" aria-hidden="true" />
    </a>
    <!-- cartel (DESIGN_BRIEF §6.3) : collant sur ordinateur, au-dessus de l'image sur mobile -->
    <div data-cartel class="flex flex-col gap-8 md:sticky md:top-24 md:col-span-4 md:self-start">
      <div>
        <h1 class="text-h1 text-balance break-words" lang={langOf(card.title.lang)}>
          {card.title.text}
        </h1>
        {/* le sceau signe la fiche sous le titre, sans lui prendre de largeur ; sans image, il occupe déjà le cadre */}
        {(card.period || card.image) && (
          <p class="mt-4 flex items-center gap-3 text-meta text-ink-muted">
            {card.image && (
              <Seal slug={slug} provenance={data.provenance} class="aspect-square w-9" />
            )}
            {card.period}
          </p>
        )}
      </div>
      <p class="text-ink-muted" lang={langOf(card.summary.lang)}>
        {card.summary.text}
      </p>
      <dl class="grid grid-cols-[auto_1fr] items-baseline gap-x-6 gap-y-3 border-t border-line pt-6 text-small">
        <dt class={dt}>{t(locale, "project.category")}</dt>
        <dd>{t(locale, `category.${data.category}`)}</dd>
        <dt class={dt}>{t(locale, "project.fabrication")}</dt>
        <dd class="flex flex-wrap items-center gap-2">
          <Tag accent>{t(locale, `provenance.${data.provenance}`)}</Tag>
          {data.platform && <span>{data.platform}</span>}
        </dd>
        {stack.length > 0 && (
          <>
            <dt class={dt}>{t(locale, "project.stack")}</dt>
            <dd>{stack.join(", ")}</dd>
          </>
        )}
        {role && (
          <>
            <dt class={dt}>{t(locale, "project.role")}</dt>
            <dd lang={langOf(role.lang)}>{role.text}</dd>
          </>
        )}
        {status && (
          <>
            <dt class={dt}>{t(locale, "project.status")}</dt>
            <dd>{t(locale, `status.${status}`)}</dd>
          </>
        )}
      </dl>
      {(data.liveUrl || data.repo) && (
        <div class="flex flex-wrap gap-3">
          {data.liveUrl && (
            <Button href={data.liveUrl} target="_blank" rel="noopener noreferrer">
              {t(locale, "cta.site")}
              <Icon name="ph:arrow-up-right" class="size-4" aria-hidden="true" />
              <span class="sr-only">{t(locale, "a11y.newTab")}</span>
            </Button>
          )}
          {data.repo && (
            <Button
              href={`https://github.com/${data.repo}`}
              variant={data.liveUrl ? "secondary" : "primary"}
            >
              <Icon name="ph:github-logo" class="size-4" aria-hidden="true" />
              {t(locale, "cta.code")}
            </Button>
          )}
        </div>
      )}
    </div>

    <div class="flex min-w-0 flex-col gap-12 md:col-span-8">
      <!-- cadre sobre : bordure 1 px, rayon 10 px, domaine en barre supérieure, pas de fausses pastilles -->
      <figure
        data-preview
        transition:name={`apercu-${slug}`}
        class="overflow-hidden rounded-panel border border-line"
      >
        {data.liveUrl && (
          <figcaption class="flex h-9 items-center border-b border-line bg-surface px-4 text-meta text-ink-muted">
            {domainOf(data.liveUrl)}
          </figcaption>
        )}
        <div class="aspect-[16/10]">
          <ProjectImage
            image={card.image}
            slug={slug}
            provenance={data.provenance}
            alt={fmt(locale, "capture.alt", { title: card.title.text })}
            sizes={FICHE_SIZES}
            eager
          />
        </div>
      </figure>
      {body && (
        <div class="prose" lang={langOf(body.lang)}>
          <body.Content />
        </div>
      )}
      {data.gallery.length > 0 && (
        <div data-gallery class="flex flex-col gap-10">
          {data.gallery.map((g) => {
            const caption = g.caption ? localize(g.caption, locale) : undefined;
            return (
              <figure class="flex flex-col gap-3">
                <Image
                  src={g.src}
                  alt={localize(g.alt, locale).text}
                  widths={[480, 960, 1440]}
                  sizes="(min-width: 768px) 66vw, 100vw"
                  class="h-auto max-h-[40rem] w-auto max-w-full self-start rounded-panel border border-line"
                />
                {caption && (
                  <figcaption
                    class="max-w-prose text-small text-ink-muted"
                    lang={langOf(caption.lang)}
                  >
                    {caption.text}
                  </figcaption>
                )}
              </figure>
            );
          })}
        </div>
      )}
    </div>
  </article>
  {(prev || next) && (
    <nav
      aria-label={t(locale, "project.more")}
      class="mx-auto max-w-[1240px] px-6 pb-16 md:px-10 md:pb-28"
    >
      <div class="flex flex-wrap justify-between gap-6 border-t border-line pt-10">
        {prev ? (
          <a
            href={projectPath(prev, locale)}
            rel="prev"
            data-preview-srcset={prevSrcset}
            class="flex flex-col gap-1"
          >
            <span class="text-small text-ink-muted">{t(locale, "project.prev")}</span>
            <span class="text-h3" lang={langOf(titleOf(prev).lang)}>
              {titleOf(prev).text}
            </span>
          </a>
        ) : (
          <span />
        )}
        {next && (
          <a
            href={projectPath(next, locale)}
            rel="next"
            data-preview-srcset={nextSrcset}
            class="flex flex-col items-end gap-1 text-right"
          >
            <span class="text-small text-ink-muted">{t(locale, "project.next")}</span>
            <span class="text-h3" lang={langOf(titleOf(next).lang)}>
              {titleOf(next).text}
            </span>
          </a>
        )}
      </div>
    </nav>
  )}
</Base>

<script>
  // Fermer redescend l'aperçu dans sa carte en revenant d'un cran, mais seulement si la page précédente est bien
  // celle qui a ouvert la fiche (grille, accueil). Après « projet suivant » ou un changement de langue, la page
  // précédente est une autre fiche : le lien mène alors à la grille. Sans l'API Navigation, le lien suffit.
  type Entry = { url: string | null; index: number };
  const isFiche = (path: string) => /\/(projets|projects)\/[^/]+\/$/.test(path);
  document.addEventListener("astro:page-load", () => {
    document.querySelector<HTMLAnchorElement>("a[data-close]")?.addEventListener("click", (e) => {
      if (e.metaKey || e.ctrlKey || e.shiftKey) return;
      const nav = (window as { navigation?: { entries(): Entry[]; currentEntry: Entry | null } })
        .navigation;
      const before = nav?.currentEntry && nav.entries()[nav.currentEntry.index - 1];
      if (before?.url && !isFiche(new URL(before.url).pathname)) {
        e.preventDefault();
        history.back();
      }
    });
  });
</script>
