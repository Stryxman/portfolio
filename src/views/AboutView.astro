---
import { existsSync } from "node:fs";
import { join } from "node:path";
import { getCollection } from "astro:content";
import { Image } from "astro:assets";
import Base from "../layouts/Base.astro";
import { locales, type Locale } from "../i18n/config";
import { t } from "../i18n/ui";
import { alternatesFor } from "../i18n/routes";
import { localize } from "../lib/content/select";
import { experienceSchema, skillSchema } from "../lib/content/schemas";
import { getProfile, getSkills } from "../lib/content/queries";
import { formatPeriod } from "../lib/projects/model";
import Button from "../components/Button.astro";
import Tag from "../components/Tag.astro";
import SocialLinks from "../components/SocialLinks.astro";
interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
const profile = await getProfile();
const bio = localize(profile.bio, locale);
const skills = (await getSkills()).filter((s) => s.showOnAbout);
const skillGroups = skillSchema.shape.category.options
  .map((c) => [c, skills.filter((s) => s.category === c)] as const)
  .filter(([, list]) => list.length > 0);
const experiences = (await getCollection("experiences"))
  .map((e) => e.data)
  .sort((a, b) => a.order - b.order);
const journey = experienceSchema.shape.kind.options
  .map((k) => [k, experiences.filter((e) => e.kind === k)] as const)
  .filter(([, list]) => list.length > 0);
// un bouton par CV réellement déposé dans public/cv/ (DESIGN_BRIEF §6.4)
const cvs = locales.filter((l) => existsSync(join(process.cwd(), "public", "cv", `cv-${l}.pdf`)));
const title = t(locale, "page.about.title");
const langOf = (lang: Locale) => (lang === locale ? undefined : lang);
const section = "mx-auto max-w-[1240px] px-6 py-16 md:px-10 md:py-28";
---

<Base
  locale={locale}
  title={`${title} | ${profile.fullName}`}
  description={t(locale, "page.about.description")}
  alternates={alternatesFor("about")}
>
  <section class:list={[section, "grid gap-12 md:grid-cols-12"]}>
    <div class="md:col-span-7">
      <h1 class="text-h1">{title}</h1>
      <div class="mt-8 flex max-w-prose flex-col gap-5" lang={langOf(bio.lang)}>
        {bio.text.split(/\n\s*\n/).map((p) => (
          <p>{p}</p>
        ))}
      </div>
      {cvs.length > 0 && (
        <div class="mt-10 flex flex-wrap gap-3">
          {cvs.map((l) => (
            <Button
              href={`/cv/cv-${l}.pdf`}
              download
              hreflang={l}
              lang={l}
              variant={l === locale ? "primary" : "secondary"}
            >
              {`${t(l, "cta.cv")} (${l.toUpperCase()})`}
            </Button>
          ))}
        </div>
      )}
    </div>
    {profile.portrait && (
      <Image
        src={profile.portrait}
        alt={profile.fullName}
        widths={[400, 800]}
        sizes="(min-width: 768px) 40vw, 100vw"
        class="aspect-[3/4] w-full rounded-panel border border-line object-cover md:col-span-5"
      />
    )}
  </section>

  {journey.length > 0 && (
    <section class:list={[section, "border-t border-line"]}>
      <h2 class="text-h2">{t(locale, "about.journey")}</h2>
      {journey.map(([kind, items]) => (
        <div class="mt-10">
          <h3 class="text-h3">{t(locale, `experience.${kind}`)}</h3>
          <ol class="mt-4 divide-y divide-line border-y border-line">
            {items.map((e) => {
              const role = localize(e.title, locale);
              return (
                <li class="grid gap-2 py-5 md:grid-cols-[10rem_1fr] md:gap-8">
                  <span class="text-meta text-ink-muted">
                    {formatPeriod(e.start, e.end, locale)}
                  </span>
                  <div>
                    <p class="font-medium" lang={langOf(role.lang)}>
                      {role.text}
                    </p>
                    <p class="text-small text-ink-muted">
                      {e.organization}
                      {e.location && `, ${localize(e.location, locale).text}`}
                    </p>
                    {e.description && (
                      <p class="mt-2 max-w-prose text-small">
                        {localize(e.description, locale).text}
                      </p>
                    )}
                  </div>
                </li>
              );
            })}
          </ol>
        </div>
      ))}
    </section>
  )}

  <section class:list={[section, "border-t border-line"]}>
    <h2 class="text-h2">{t(locale, "about.skills")}</h2>
    <div class="mt-10 grid gap-10 sm:grid-cols-2 lg:grid-cols-3">
      {skillGroups.map(([category, list]) => (
        <div>
          <h3 class="text-h3">{t(locale, `skill.${category}`)}</h3>
          <ul class="mt-4 flex flex-wrap gap-2">
            {list.map((s) => (
              <li>
                <Tag>{s.name}</Tag>
              </li>
            ))}
          </ul>
        </div>
      ))}
    </div>
  </section>

  <section id="contact" class:list={[section, "scroll-mt-16 border-t border-line"]}>
    <h2 class="text-h2">{t(locale, "nav.contact")}</h2>
    <p class="mt-6 max-w-prose text-ink-muted">{t(locale, "contact.intro")}</p>
    <SocialLinks locale={locale} withLabels class="mt-6 -ml-2" />
  </section>
</Base>
