---
import { Icon } from "astro-icon/components";
import Base from "../layouts/Base.astro";
import type { Locale } from "../i18n/config";
import { t } from "../i18n/ui";
import { alternatesFor, pathFor } from "../i18n/routes";
import { contactHref } from "../i18n/nav";
import { localize } from "../lib/content/select";
import { cardOf, getProfile, getProjectEntries, getSkills } from "../lib/content/queries";
import FieldStatic from "../components/FieldStatic.astro";
import ProjectCard from "../components/ProjectCard.astro";
import Button from "../components/Button.astro";
import Tag from "../components/Tag.astro";
interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
const profile = await getProfile();
const entries = await getProjectEntries();
// projets mis en avant, sinon tous (tant qu'il y en a peu)
const shown = (
  entries.some((e) => e.data.featured) ? entries.filter((e) => e.data.featured) : entries
).map((e) => cardOf(e, locale));
const keySkills = (await getSkills()).filter((s) => s.showOnAbout).slice(0, 6);
const role = localize(profile.role, locale);
const headline = localize(profile.headline, locale);
const tagline = localize(profile.tagline, locale);
const bio = localize(profile.bio, locale);
const intro = bio.text.split(/\n\s*\n/)[0]; // l'accueil ne montre que le premier paragraphe
const langOf = (lang: Locale) => (lang === locale ? undefined : lang);
const section = "mx-auto max-w-[1240px] px-6 py-16 md:px-10 md:py-28";
---

<Base
  locale={locale}
  title={`${profile.fullName} | ${role.text}`}
  description={tagline.text}
  alternates={alternatesFor("home")}
>
  <section class="relative overflow-hidden">
    <FieldStatic />
    <div class="relative z-10 mx-auto flex min-h-[calc(100dvh-4rem)] max-w-[1240px] flex-col justify-center px-6 py-16 md:px-10">
      <div class="md:w-5/12">
        <p class="text-small text-ink-muted" lang={langOf(role.lang)}>
          {role.text}
        </p>
        <h1 class="mt-4 text-display text-balance" lang={langOf(headline.lang)}>
          {headline.text}
        </h1>
        <p class="mt-6 max-w-prose text-ink-muted" lang={langOf(tagline.lang)}>
          {tagline.text}
        </p>
        <div class="mt-10 flex flex-wrap gap-3">
          <Button href={pathFor("projects", locale)}>{t(locale, "cta.projects")}</Button>
          <Button href={contactHref(locale)} variant="secondary">
            {t(locale, "cta.contact")}
          </Button>
        </div>
      </div>
    </div>
  </section>

  {shown.length > 0 && (
    <section class={section}>
      <h2 class="text-h2">{t(locale, "home.featured")}</h2>
      <div data-featured class="mt-12 grid gap-x-10 gap-y-16 md:grid-cols-2">
        {shown.map((card) => (
          <ProjectCard card={card} locale={locale} />
        ))}
      </div>
    </section>
  )}

  <section class:list={[section, "border-t border-line"]}>
    <div class="md:w-8/12">
      <h2 class="text-h2">{t(locale, "home.profile")}</h2>
      <p class="mt-6 max-w-prose text-ink-muted" lang={langOf(bio.lang)}>
        {intro}
      </p>
      {keySkills.length > 0 && (
        <ul class="mt-8 flex flex-wrap gap-2">
          {keySkills.map((s) => (
            <li>
              <Tag>{s.name}</Tag>
            </li>
          ))}
        </ul>
      )}
      <a
        href={pathFor("about", locale)}
        class="mt-8 inline-flex h-11 items-center gap-2 text-accent underline underline-offset-4"
      >
        {t(locale, "nav.about")}
        <Icon name="ph:arrow-right" class="size-4" aria-hidden="true" />
      </a>
    </div>
  </section>
</Base>
