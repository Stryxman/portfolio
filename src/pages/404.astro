---
import Base from "../layouts/Base.astro";
import { alternatesFor } from "../i18n/routes";
---

<Base
  locale="fr"
  title="Page introuvable | Page not found"
  description="404"
  alternates={alternatesFor("home")}
>
  <section class="mx-auto max-w-[1240px] px-6 py-16 md:px-10 md:py-28">
    <h1 class="text-h1">Page introuvable</h1>
    <p lang="en" class="mt-2 text-h3 text-ink-muted">Page not found</p>
    <p class="mt-8 flex gap-6">
      <a href="/fr/" class="text-accent underline">Accueil</a>
      <a href="/en/" lang="en" class="text-accent underline">Home</a>
    </p>
  </section>
</Base>
