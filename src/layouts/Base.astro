---
import "../styles/global.css";
import { Font } from "astro:assets";
import { ClientRouter } from "astro:transitions";
import type { Locale } from "../i18n/config";
import { t } from "../i18n/ui";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";

interface Props {
  locale: Locale;
  title: string;
  description: string;
  alternates: Record<Locale, string>;
}
const { locale, title, description, alternates } = Astro.props;
const site = Astro.site!;
---

<!doctype html>
<html lang={locale}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={new URL(alternates[locale], site)} />
    <link rel="alternate" hreflang="fr" href={new URL(alternates.fr, site)} />
    <link rel="alternate" hreflang="en" href={new URL(alternates.en, site)} />
    <link rel="alternate" hreflang="x-default" href={new URL(alternates.fr, site)} />
    <meta name="color-scheme" content="light dark" />
    <script is:inline>
      (() => {
        const apply = () => {
          let saved = null;
          try {
            saved = localStorage.getItem("theme");
          } catch {
            // stockage bloqué (navigation privée, cookies refusés) : thème sombre par défaut
          }
          // sombre par défaut (choix de Richard, 2026-10-15) ; le choix du visiteur est mémorisé
          document.documentElement.dataset.theme = saved === "light" ? "light" : "dark";
        };
        apply();
        // ouverture du site : jouée une seule fois, au chargement complet. ClientRouter retire l'attribut au swap,
        // la chorégraphie ne se rejoue donc pas en revenant sur l'accueil ; sans JavaScript, le texte reste visible.
        document.documentElement.dataset.intro = "";
        // ClientRouter remplace les attributs de <html> au swap : on réapplique avant le rendu
        document.addEventListener("astro:after-swap", apply);
      })();
    </script>
    <Font cssVariable="--font-geist" preload />
    <Font cssVariable="--font-geist-mono" />
    <ClientRouter />
  </head>
  <body class="min-h-dvh bg-bg text-ink">
    <a
      href="#contenu"
      class="sr-only rounded-control bg-accent px-4 py-2 text-accent-ink focus:not-sr-only focus:fixed focus:top-3 focus:left-3 focus:z-[70]"
    >
      {t(locale, "nav.skip")}
    </a>
    <Header locale={locale} alternates={alternates} />
    <main id="contenu" tabindex="-1" class="outline-none">
      <slot />
    </main>
    <Footer locale={locale} />
  </body>
</html>

<script>
  // Ouverture d'un projet sans à-coup : l'image de la fiche est demandée dès le survol (ou le focus) du lien,
  // et la navigation lui laisse jusqu'à 250 ms pour finir de se charger. Sans cela, la fiche s'ouvre sur un
  // cadre vide et l'image arrive en cours d'animation.
  import { FICHE_SIZES } from "../lib/projects/preview";

  const warm = new Map<string, Promise<unknown>>();
  // même retenue que le préchargement des pages : rien en économie de données ni sur une connexion lente
  const link = (navigator as { connection?: { saveData?: boolean; effectiveType?: string } })
    .connection;
  const frugal = !!link?.saveData || /2g/.test(link?.effectiveType ?? "");
  const warmUp = (e: Event) => {
    const a = e.target instanceof Element ? e.target.closest<HTMLAnchorElement>("a[href]") : null;
    if (frugal || !a || warm.has(a.href)) return;
    // carte : les fichiers de sa propre image, à la taille de la fiche ; lien précédent / suivant : srcset fourni au build
    const srcset =
      a.dataset.previewSrcset ?? a.closest("[data-project]")?.querySelector("img")?.srcset;
    if (!srcset) return;
    const img = new Image();
    // on attend le chargement lui-même : decode() peut être rejeté d'emblée sur une image qui n'a qu'un srcset
    warm.set(a.href, new Promise((done) => (img.onload = img.onerror = () => done(undefined))));
    img.sizes = FICHE_SIZES;
    img.srcset = srcset;
  };
  // survol et focus seulement : au toucher, un doigt posé pour faire défiler chargerait une image par carte
  for (const type of ["pointerover", "focusin"])
    document.addEventListener(type, warmUp, { passive: true });
  document.addEventListener("astro:before-preparation", (e) => {
    const ready = warm.get(e.to.href);
    if (!ready) return;
    const load = e.loader;
    e.loader = async () => {
      await load();
      await Promise.race([ready, new Promise((done) => setTimeout(done, 250))]);
    };
  });
</script>
